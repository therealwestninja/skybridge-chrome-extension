{
  "manifest_version": 3,
  "name": "Rook AI",
  "version": "1.4.7",
  "description": "Your Agent. Your Data. Wherever you go.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["page-sensor.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://perchance.org/*", "*://*.perchance.org/*"],
      "js": ["remote-host.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://perchance.org/*", "*://*.perchance.org/*"],
      "js": ["rook-skybridge-anchor.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://perchance.org/*", "https://*.perchance.org/*", "https://en.wikipedia.org/*", "https://api.duckduckgo.com/*", "https://api.open-meteo.com/*", "https://api.dictionaryapi.dev/*", "https://translate.googleapis.com/*", "https://api.gencraft.com/*", "https://cdn.gencraft.com/*", "https://*.uploads.dev/*"],
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["storage", "alarms", "notifications", "sidePanel", "contextMenus", "offscreen", "geolocation"],
  "action": { "default_title": "Rook AI — Your Agent. Your Data. Wherever you go.", "default_popup": "popup.html" },
  "side_panel": { "default_path": "console.html" },
  "omnibox": { "keyword": "rook" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Open the Rook menu" },
    "open-rook-panel": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Open Rook in the side panel" }
  }
}
